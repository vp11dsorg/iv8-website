---
import Base from '../layouts/Base.astro';
const base='/iv8-website';
const groups=[
 {t:'Design & Experience',d:'Websites people remember — and use.',h:'/services/website-services'},
 {t:'Build for Non-Technical People',d:'Your site, editable by you. WordPress, Shopify, Wix or Squarespace.',h:'/services/website-services'},
 {t:'Managed Hosting',d:'WordPress, VPS and dedicated — set up, secured and watched.',h:'/services/managed-hosting'},
 {t:'Cloud & Containers',d:'Kubernetes, OpenShift and containers, run for you.',h:'/services/professional-services'},
 {t:'AI & Compliance',d:'AI that helps, compliance that holds. Readiness, not certification.',h:'/services/professional-services'},
 {t:'Talent',d:'Extra hands, when you need them. Staffing and a vetted marketplace.',h:'/services/professional-services'},
];
const faqs=[
 ['How much does a website cost?','Every project is quoted. Tell us your budget in the form and we will tell you what fits — before you commit to anything.'],
 ['How long does it take?','Most websites: 4–6 weeks from first call to launch. A focused build with ready content: 3 weeks.'],
 ['Do you work outside Canada?','Yes — we are based in Canada and work worldwide, in your time zone.'],
 ['Who owns the website?','You do. Domain, website, content and data — all in your accounts, in your name.'],
 ['What happens after launch?','Care plans cover hosting, updates, backups and small changes. Cancel anytime with 30 days notice.'],
];
---
<Base>
<section class="hero"><div class="container">
<p class="eyebrow" style="color:var(--cyan)">Web Design · Toronto, Canada — Working Worldwide</p>
<h1>A website that sells <em>while you sleep.</em></h1>
<p>iv8 is a team of 10–20 designers who design, build and run websites, stores and apps for businesses that want more enquiries, more sales, and fewer headaches.</p>
<div class="cta-row"><a class="btn" href={`${base}/contact`}>Start a Project →</a><a class="btn ghost" style="color:#fff;border-color:#fff" href={`${base}/work`}>See our work</a></div>
<p class="micro">Custom design · No templates · Fast, mobile-first</p>
</div></section>
<div class="trust"><div class="container">Built on the platforms the world uses — <strong>WordPress 38.6% of the web · Shopify 5.4% · Wix 4.2% · Squarespace 2.4%</strong></div></div>
<section><div class="container"><p class="eyebrow">What we do</p><h2>Everything you need to launch, run and grow online — in one team.</h2>
<div class="grid3">{groups.map(g=><div class="card"><h3>{g.t}</h3><p>{g.d}</p><a href={base+g.h}>Explore →</a></div>)}</div></div></section>
<section style="background:var(--bg)"><div class="container"><p class="eyebrow">Featured work</p><h2>Work that worked.</h2>
<div class="grid3">
<div class="work-card"><div class="art">+64%</div><div class="body"><h3>Clinic website redesign</h3><p>Enquiries up 64% in 3 months after a faster, clearer site.</p><a href={`${base}/work`}>Read the case →</a></div></div>
<div class="work-card"><div class="art">2.1×</div><div class="body"><h3>Online store rebuild</h3><p>Sales 2.1× after a Shopify rebuild and checkout fix.</p><a href={`${base}/work`}>Read the case →</a></div></div>
<div class="work-card"><div class="art">0.9s</div><div class="body"><h3>Service business site</h3><p>Load time cut to 0.9s — and phone calls followed.</p><a href={`${base}/work`}>Read the case →</a></div></div>
</div><p style="margin-top:20px"><a href={`${base}/work`}>See all work →</a></p></div></section>
<section><div class="container"><p class="eyebrow">Why iv8</p><h2>One team, start to finish.</h2>
<div class="grid3">
<div class="card"><div class="icon">🤝</div><h3>No hand-offs</h3><p>Design, build, hosting and care — one team, no messages lost between vendors.</p></div>
<div class="card"><div class="icon">⚡</div><h3>Fast by default</h3><p>Every site is built to load in under 1.5 seconds. Speed is a feature, not an add-on.</p></div>
<div class="card"><div class="icon">🔑</div><h3>You own everything</h3><p>Your domain, your site, your data. No lock-in, ever.</p></div>
</div></div></section>
<section style="background:var(--bg)"><div class="container"><p class="eyebrow">How it works</p><h2>From first call to launch in 4–6 weeks.</h2>
<div class="steps">
<div class="step"><b>01</b><h3>Discover</h3><p>Week 1 — we learn your business and goals.</p></div>
<div class="step"><b>02</b><h3>Design</h3><p>Weeks 2–3 — you see it on desktop and phone.</p></div>
<div class="step"><b>03</b><h3>Build</h3><p>Weeks 3–5 — design becomes a fast, working site.</p></div>
<div class="step"><b>04</b><h3>Launch</h3><p>Week 5–6 — tested, hosted, live.</p></div>
<div class="step"><b>05</b><h3>Care</h3><p>Ongoing — updates, backups, small changes.</p></div>
</div><p style="margin-top:20px"><a href={`${base}/process`}>See the full process →</a></p></div></section>
<section><div class="container"><p class="eyebrow">Hosting</p><h2>Hosting that just works.</h2><p style="max-width:640px">Managed WordPress, VPS and dedicated — set up, secured and watched for you. You never touch a server.</p>
<div class="grid3">
<div class="card"><h3>Managed WordPress</h3><p>Hosting, updates and backups handled.</p><a href={`${base}/services/managed-wordpress`}>Explore →</a></div>
<div class="card"><h3>VPS</h3><p>Your own server, managed for you.</p><a href={`${base}/services/vps-hosting`}>Explore →</a></div>
<div class="card"><h3>Dedicated</h3><p>A whole server, just for you.</p><a href={`${base}/services/dedicated-hosting`}>Explore →</a></div>
</div></div></section>
<section style="background:var(--bg)"><div class="container"><p class="eyebrow">What clients say</p><h2>First stories coming.</h2><p>We are a new team shipping our first client work. Our first client stories land here — real quotes, real names, no invented testimonials.</p><blockquote style="font-size:22px;color:var(--navy);border-left:4px solid var(--cyan);padding-left:20px">“We build the site we'd want to use ourselves — fast, clear, and honest.”<footer style="font-size:15px;color:var(--muted)">— The iv8 team</footer></blockquote></div></section>
<section><div class="container faq"><p class="eyebrow">FAQ</p><h2>Before you ask.</h2>
{faqs.map(f=><details><summary>{f[0]}</summary><p style="margin-top:10px">{f[1]}</p></details>)}
</div></section>
</Base>
